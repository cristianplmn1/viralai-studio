# ─────────────────────────────────────────────────────────────
# ViralAI Studio — variables de entorno
# Copia este fichero a `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# URL pública de la aplicación (se usa en las redirecciones OAuth)
APP_URL=http://localhost:3000
NODE_ENV=development

# Secreto de sesión: firma cookies HMAC y cifra los tokens OAuth (AES-256-GCM).
# En producción usa una cadena aleatoria de al menos 32 caracteres.
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga-en-produccion

# ─────────────────────────────────────────────────────────────
# Supabase (opcional)
# Si no se define, la aplicación arranca en MODO LOCAL:
# usuarios, proyectos y medios se guardan en ./storage
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# OAuth — YouTube (Google Cloud Console → APIs & Services → Credentials)
# Habilita la API "YouTube Data API v3" y configura la URI de redirección:
#   http://localhost:3000/api/oauth/youtube/callback
# ─────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# OAuth — TikTok (TikTok for Developers → Content Posting API)
# URI de redirección:
#   http://localhost:3000/api/oauth/tiktok/callback
# ─────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# IA opcional (OpenAI o cualquier endpoint compatible)
# Sin esta clave el sistema usa el generador heurístico local y
# los subtítulos animados de palabras clave.
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ─────────────────────────────────────────────────────────────
# yt-dlp (importación por enlace)
# ─────────────────────────────────────────────────────────────
# YouTube pide verificación ("Sign in to confirm you're not a bot") cuando
# detecta uso automatizado. Con las cookies de tu navegador se resuelve:
#   YT_DLP_COOKIES_FROM_BROWSER=chrome   (chrome, firefox, edge, brave…)
# o con un fichero de cookies exportado:
#   YT_DLP_COOKIES_FILE=./cookies.txt
# YT_DLP_PATH=/ruta/al/yt-dlp

# ─────────────────────────────────────────────────────────────
# Almacenamiento local de medios (solo en modo local)
# ─────────────────────────────────────────────────────────────
STORAGE_DIR=./storage

# Permite simular publicaciones cuando no hay credenciales OAuth reales.
ALLOW_DEMO_PUBLISHING=true

# ─────────────────────────────────────────────────────────────
# Binarios externos (opcional). Si no se definen se usan los que
# instaló ffmpeg-static / ffprobe-static.
# ─────────────────────────────────────────────────────────────
# FFMPEG_PATH=
# FFPROBE_PATH=
